# Optional GitHub token for higher REST API rate limits. Public repos work without it.
GITHUB_TOKEN=

# GitHub API origin is locked to the official host.
GITHUB_API_BASE=https://api.github.com

# OpenAI-compatible chat API (Groq example). Leave empty to use heuristic analysis + keyword chat fallback.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Optional embeddings (Groq may not provide embeddings). Keyword/FTS retrieval is used when unset.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Repository ingest limits
MAX_FILES=80
MAX_FILE_BYTES=120000
MAX_TOTAL_CHARS=250000
MAX_TREE_ITEMS=5000
MAX_CHUNKS=1200
CHUNK_LINES=80
CHUNK_OVERLAP=12
GITHUB_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=25
CONNECT_TIMEOUT_SECONDS=8

# Local SQLite database. On ephemeral hosts this file is lost on restart.
DATABASE_PATH=./data/repomind.db

ANALYZE_RATE_LIMIT=20
ANALYZE_RATE_WINDOW_SECONDS=600
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
LOG_LEVEL=INFO
